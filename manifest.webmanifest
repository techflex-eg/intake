{
  "name": "TechFlex",
  "short_name": "TechFlex",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f2f8",
  "theme_color": "#674ea7",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "photos",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  },
  "lang": "ar",
  "dir": "rtl"
}
